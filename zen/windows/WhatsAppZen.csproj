<Project Sdk="Microsoft.NET.Sdk">
  <!-- WhatsApp Zen for Windows: a WinUI 3 window over the Rust core
       (zen_core.dll, built from ../core as a cdylib; see
       .github/workflows/windows.yml). Unpackaged and self-contained, so the
       published folder runs as it is. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>WhatsAppZen</RootNamespace>
    <AssemblyName>WhatsAppZen</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.1.0</Version>
    <Product>WhatsApp Zen</Product>
    <Company>Mehmet Deniz Aydın</Company>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250205002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\target\release\zen_core.dll" Link="zen_core.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\target\release\zen_core.dll')" />
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
